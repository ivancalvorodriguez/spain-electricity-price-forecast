# Copia este fichero como .env y rellena la contraseña.
# Usuario y base, los mismos que en Neon; la contraseña, una solo para local.
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=
POSTGRES_DB=neondb

# Cadena directa de Neon (Connect, sin Connection pooling: el host sin -pooler).
# Solo para aplicar migraciones desde aquí; nunca en Render, que usa el pooler.
DATABASE_URL_DIRECT=
